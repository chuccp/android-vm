<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/runtime_feature_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/runtime_included_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/xml_included"
        android:textColor="@color/runtime_accent"
        android:textSize="@dimen/runtime_body_size" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/xml_included_desc"
        android:textColor="@color/runtime_body"
        android:textSize="14sp" />
</LinearLayout>
