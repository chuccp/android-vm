// ---- core/framework_builtins.cc（51 类）----
// （SharedPreferences 面已按 §31.7 B 档归位 lib：android.content.SharedPreferences*
//  纯 Java 源随 runtime.dex 打包；VM 侧仅 Context.getSharedPreferences 薄钩子。
//  android.os.Bundle 亦已归位 lib（POJO→lib，内存 HashMap 数据载体）；
//  android.content.ContentValues 同（POJO→lib）；android.content.UriMatcher
//  纯逻辑→lib；android.content.ContentResolver = B 档 CRUD 路由钩子内建。）
